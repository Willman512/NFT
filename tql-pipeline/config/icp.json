{
  "_comment": "Starting point only. `prospect.py learn` adjusts these weights from your real outcomes. Patterns are case-insensitive regexes matched against all fetched page text.",
  "bias": -1.0,
  "thresholds": {"go": 0.60, "skip": 0.35},
  "signals": {
    "manufacturer":      {"kind": "fit", "weight": 1.4, "label": "Makes its own product (manufacturer/fabricator/plant)",
                          "patterns": ["\\bmanufactur(e|er|ers|es|ing)\\b", "\\bfabricat", "\\bwe (make|build|produce|mill)\\b", "\\bfactory\\b", "\\bproduction facilit"]},
    "distributor":       {"kind": "fit", "weight": 1.0, "label": "Distributor / wholesaler",
                          "patterns": ["\\bdistributor", "\\bwholesale", "\\bdistribution (center|centre|network)"]},
    "food_producer":     {"kind": "fit", "weight": 0.9, "label": "Grower / packer / food or beverage producer",
                          "patterns": ["\\bgrowers?\\b", "\\bpack(er|ers|ing house|inghouse)\\b", "\\bprocessor\\b", "\\bbrewery\\b", "\\bwinery\\b", "\\bbakery\\b", "\\bco-?packer"]},
    "palletized":        {"kind": "fit", "weight": 0.8, "label": "Pallet / truckload / LTL freight language",
                          "patterns": ["\\bpallets?\\b", "\\btruckloads?\\b", "\\bLTL\\b", "\\bfull truck", "\\bfreight\\b"]},
    "flatbed_oversize":  {"kind": "fit", "weight": 1.1, "label": "Flatbed / oversized / heavy freight",
                          "patterns": ["\\bflatbed", "\\bsteel\\b", "\\blumber\\b", "\\btruss(es)?\\b", "\\bprecast\\b", "\\bheavy equipment\\b", "\\bmachinery\\b", "\\boversiz", "\\bheavy haul", "\\bcoils?\\b", "\\bpipe\\b"]},
    "reefer":            {"kind": "fit", "weight": 1.0, "label": "Temperature-controlled (reefer)",
                          "patterns": ["\\brefrigerat", "\\bfrozen\\b", "\\bcold chain", "\\btemperature[- ]controlled", "\\bperishable", "\\bdairy\\b", "\\bseafood\\b", "\\bfresh produce\\b"]},
    "hazmat":            {"kind": "fit", "weight": 0.4, "label": "Hazmat / chemicals",
                          "patterns": ["\\bhazmat\\b", "\\bhazardous material", "\\bchemicals?\\b"]},
    "retail_dealers":    {"kind": "fit", "weight": 0.9, "label": "Sells through retailers/dealers (outbound volume)",
                          "patterns": ["\\bretailers?\\b", "\\bwhere to buy\\b", "\\bdealers?\\b", "\\bstore locator\\b", "\\bgrocery\\b", "\\bhome depot\\b", "\\blowe'?s\\b", "\\bwalmart\\b", "\\bcostco\\b"]},
    "ships_national":    {"kind": "fit", "weight": 0.7, "label": "Ships nationally",
                          "patterns": ["\\bnationwide\\b", "\\ball 50 states\\b", "\\bacross the (us|u\\.s\\.|united states|country)\\b", "\\bcoast[- ]to[- ]coast\\b", "\\bthroughout (the )?(us|united states|north america)\\b"]},
    "cross_border":      {"kind": "fit", "weight": 0.6, "label": "Canada / Mexico / cross-border",
                          "patterns": ["\\bcanada\\b", "\\bmexico\\b", "\\bcross[- ]border\\b", "\\bnorth america"]},
    "multi_location":    {"kind": "fit", "weight": 0.8, "label": "Multiple plants / warehouses / DCs",
                          "patterns": ["\\b(plants|facilities|warehouses|distribution centers|locations)\\b"]},
    "controls_delivery": {"kind": "fit", "weight": 0.9, "label": "They promise/arrange delivery (own the freight)",
                          "patterns": ["\\bwe (ship|deliver)\\b", "\\bdelivery (area|policy|options|schedule)\\b", "\\bfreight (terms|policy)\\b", "\\bshipping (policy|information|info)\\b", "\\bdelivered price", "\\bf\\.?o\\.?b\\.?\\b"]},
    "logistics_roles":   {"kind": "fit", "weight": 0.8, "label": "Has shipping/logistics staff (decision-maker exists)",
                          "patterns": ["\\bshipping (manager|coordinator|supervisor)", "\\blogistics (manager|coordinator|director)", "\\btraffic manager", "\\btransportation (manager|coordinator|director)", "\\bdispatch(er)?\\b"]},
    "longevity":         {"kind": "fit", "weight": 0.3, "label": "Established business",
                          "patterns": ["\\bsince (18|19|20)\\d\\d\\b", "\\bfounded in\\b", "\\bestablished in\\b", "\\bfamily[- ]owned\\b"]},

    "broker_3pl":        {"kind": "red_flag", "weight": -1.2, "label": "They are a broker/3PL/forwarder themselves",
                          "patterns": ["\\bfreight broker", "\\b3pl\\b", "\\bthird[- ]party logistics", "\\bfreight forward", "\\bbrokerage\\b", "\\bcarrier (setup|packet|onboarding)", "\\bmc ?#? ?\\d{5,}"]},
    "service_only":      {"kind": "red_flag", "weight": -1.5, "label": "Service business (no physical freight)",
                          "patterns": ["\\bconsulting (firm|services)\\b", "\\bmarketing agency\\b", "\\bsoftware\\b", "\\bsaas\\b", "\\blaw firm\\b", "\\binsurance agency\\b", "\\baccounting firm\\b"]},
    "parcel_ecommerce":  {"kind": "red_flag", "weight": -0.5, "label": "Consumer parcel / e-commerce shipping",
                          "patterns": ["\\bfree shipping on (all )?orders", "\\badd to cart\\b", "\\bships? via (ups|fedex|usps)\\b", "\\bshopping cart\\b"]},
    "customer_pickup":   {"kind": "red_flag", "weight": -0.4, "label": "Customers pick up (they may not control freight)",
                          "patterns": ["\\bwill[- ]call\\b", "\\bcustomer pick[- ]?up\\b", "\\bpick[- ]?up only\\b"]},

    "stale_site":        {"kind": "red_flag", "weight": -0.6, "label": "Site looks stale (old copyright) — call main line first", "computed": true},
    "no_na_presence":    {"kind": "red_flag", "weight": -0.8, "label": "No North American address/phone found (ocean/air only?)", "computed": true},
    "generic_inbox_only":{"kind": "info",     "weight": -0.1, "label": "Only a generic inbox (info@/sales@) found", "computed": true},
    "named_contact":     {"kind": "info",     "weight": 0.3,  "label": "Named person/title found on site", "computed": true},
    "french_site":       {"kind": "info",     "weight": 0.0,  "label": "French-language site — email in English, greet 'Bonjour [First Name],'", "computed": true}
  }
}
