#!/bin/bash
# 🚀 Ready-to-run Solana NFT Minting Script (Devnet)
# No external files needed

# Check Node.js
if ! command -v node &> /dev/null
then
    echo "Please install Node.js >=18 manually from https://nodejs.org/"
    exit 1
fi

# Install Solana CLI
if ! command -v solana &> /dev/null
then
    echo "Installing Solana CLI..."
    sh -c "$(curl -sSfL https://release.solana.com/stable/install)"
fi

# Install Metaplex CLI
npm install -g @metaplex-foundation/cli

# Generate Devnet wallet
solana-keygen new --outfile ./devnet.json --no-bip39-passphrase
solana config set --keypair ./devnet.json
solana config set --url devnet

# Airdrop 2 SOL
solana airdrop 2

# Get wallet address
WALLET_ADDRESS=$(solana-keygen pubkey ./devnet.json)
echo "Your Devnet wallet: $WALLET_ADDRESS"

# Create assets folder
mkdir -p assets

# Create embedded sample NFT image (1x1 red PNG for simplicity)
echo "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8Xw8AAnsB9tQk6ZsAAAAASUVORK5CYII=" | base64 --decode > assets/sample_nft.png

# Create metadata JSON
cat > assets/sample_nft.json <<EOL
{
  "name": "My First NFT",
  "symbol": "MFN",
  "description": "This is a ready-to-mint NFT on Solana Devnet!",
  "seller_fee_basis_points": 500,
  "image": "sample_nft.png",
  "attributes": [
    {"trait_type": "Background", "value": "Red"},
    {"trait_type": "Rarity", "value": "Legendary"}
  ],
  "properties": {
    "files": [{"uri": "sample_nft.png", "type": "image/png"}],
    "category": "image",
    "creators": [
      {"address": "$WALLET_ADDRESS", "share": 100}
    ]
  }
}
EOL

# Upload assets
metaplex upload ./assets --env devnet --keypair ./devnet.json

# Mint NFT
metaplex mint one --env devnet --keypair ./devnet.json --metadata ./assets/sample_nft.json

echo "🎉 NFT minted! Check it on Solana Devnet Explorer:"
echo "https://explorer.solana.com/address/$WALLET_ADDRESS?cluster=devnet"
